Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # Forward everything not already /public/ to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Block sensitive files even if rewrite fails
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "^(composer\.|package|vite\.config|artisan|\.htaccess)">
    Require all denied
</FilesMatch>
